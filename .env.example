NEXT_PUBLIC_SHOP_NAME=ЛЁН

# Локально — файл SQLite. На Vercel — Turso: DATABASE_URL=libsql://<db>-<org>.turso.io и токен из `turso db tokens create <db>`
DATABASE_URL=data/shop.db
DATABASE_AUTH_TOKEN=

# Фото товаров. Пусто — файлы пишутся в UPLOAD_DIR (только локально). На Vercel токен появится сам после подключения Blob Store
BLOB_READ_WRITE_TOKEN=
UPLOAD_DIR=data/uploads

# В продакшене значения ниже обязательно заменить: с ними вход в админку отключается
ADMIN_PASSWORD=change-me
# openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters-xxxxx

# Локально — Mailpit из docker-compose (письма на http://localhost:8025).
# В продакшене — Resend по SMTP: SMTP_HOST=smtp.resend.com, SMTP_PORT=587,
# SMTP_USER=resend (буквально), SMTP_PASS=<API-ключ resend.com>.
# MAIL_FROM должен быть на домене, подтверждённом в Resend, иначе письма отклонятся.
# Без своего домена — Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<ваш@gmail.com>,
# SMTP_PASS=<пароль приложения, myaccount.google.com/apppasswords>, MAIL_FROM="ЛЁН <ваш@gmail.com>".
# Лимит ~500 писем в сутки. Нужен для кодов входа в кабинет: Resend без домена шлёт только на ваш адрес.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ЛЁН <shop@example.com>"
SELLER_EMAIL=seller@example.com
